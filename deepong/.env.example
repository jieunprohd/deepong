# 프론트엔드 환경변수 템플릿
#  - 로컬 개발: .env.local 로 복사 (gitignore됨)
#  - Vercel/배포: 호스팅 콘솔에서 동일 키 등록
#
# Next.js의 NEXT_PUBLIC_* 변수는 빌드 시점에 클라이언트 번들에 포함됨.
# 시크릿(서버 전용)은 절대 NEXT_PUBLIC_* 으로 두지 말 것.

# API 서버 베이스 URL
#  로컬:        http://localhost:4000/api/v1
#  VM 운영:      http://34.64.243.38:4000/api/v1
#  도메인 운영:   https://api.deepong.example.com/api/v1
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
