# VM의 ~/deepong/.env.production 으로 복사 후 실제 값 입력.
# docker compose가 이 파일을 --env-file로 읽음.
#
# ⚠️  이 example 파일에는 절대 진짜 시크릿을 넣지 마십시오 — git 추적 대상입니다.
# ⚠️  진짜 값은 VM의 .env.production (gitignored)에만 둡니다.

# ===== Domain =====
# 무료 도메인 예: yourname.duckdns.org, yourname.no-ip.com 등
# 도메인이 발급되어 80/443 포트가 열려있고 A record가 VM IP를 가리키면 자동 HTTPS
# 비워두면 :80 HTTP만 (IP 기반 데모)
DOMAIN=

# ===== MySQL =====
# 강한 패스워드 권장: openssl rand -base64 24
# '!', '$', '`' 등 셸 특수문자는 docker compose 보간에서 깨질 수 있어 영숫자만 권장
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_NAME=deepong
DB_USERNAME=deepong
DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# ===== Auth (JWT) =====
# openssl rand -hex 32 로 생성한 비밀키 사용
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ===== Google OAuth =====
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# 비워두면 Google 로그인 비활성 (Strategy 등록 시 미충족이면 부팅 실패하므로 값 필요)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_PASSWORD=
# 도메인 적용 시: https://your-domain/api/v1/auth/google/callback
# IP 모드: http://VM_IP:4000/api/v1/auth/google/callback (4000은 임시, caddy 적용 시 :80/:443)
OAUTH_CALLBACK_URL=

# ===== Kakao OAuth =====
KAKAO_CLIENT_ID=
KAKAO_CALLBACK_URL=

# ===== Frontend CORS =====
# 프론트가 호출하는 origin. main.ts의 parseCorsOrigin이 처리.
#  - '*'                                       : 모든 origin 허용 (데모)
#  - 'https://app.deepong.example.com'          : 단일 origin
#  - 'http://localhost:3000,https://app.demo'   : 콤마 구분 다중 허용
WEB_ORIGIN=*
