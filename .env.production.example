# VM(34.64.243.38)의 ~/deepong/.env.production 으로 복사 후 실제 값 입력
# docker compose가 이 파일을 --env-file로 읽음
#
# 절대 git에 커밋하지 마십시오. .gitignore에 .env / .env.* 등록됨.

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=changeme-root-strong-pw
DB_NAME=deepong
DB_USERNAME=deepong
DB_PASSWORD=changeme-app-strong-pw

# ===== Auth (JWT) =====
# openssl rand -hex 32 로 생성한 비밀키 사용
JWT_SECRET=replace-me-32-bytes-hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ===== Google OAuth =====
# 도메인 미정 단계에서는 비워두거나 IP 기반으로 설정
OAUTH_CLIENT_ID=
OAUTH_CLIENT_PASSWORD=
OAUTH_CALLBACK_URL=http://34.64.243.38:4000/api/v1/auth/google/callback

# ===== Kakao OAuth =====
KAKAO_CLIENT_ID=
KAKAO_CALLBACK_URL=http://34.64.243.38:4000/api/v1/auth/kakao/callback

# ===== Frontend CORS =====
# 프론트가 배포되면 정확한 origin 입력. 데모 단계는 * 허용
WEB_ORIGIN=*
