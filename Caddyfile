# Caddy 운영 설정
#
# 동작 모드 두 가지:
#  1) DOMAIN 환경변수가 있으면 → 자동 HTTPS (Let's Encrypt 발급, 80→443 리다이렉트)
#  2) DOMAIN 미설정 → :80 HTTP 리버스 프록시만 (IP 직접 접근용 데모)
#
# 도메인 설정 후 적용:
#   .env.production 에 DOMAIN=deepong.duckdns.org 추가 → docker compose up -d
#
# 참고:
#  - DOMAIN과 함께 80/443 포트가 GCP 방화벽에서 열려 있어야 ACME 챌린지 통과
#  - DuckDNS 등 무료 서브도메인은 정상 발급 가능

# DOMAIN 환경변수 사용 — Caddyfile 안에서 {$DOMAIN} 으로 참조
{
	# Let's Encrypt 등록용 이메일 (선택). 발급 알림·복구 채널.
	# 데모는 비워두고 운영화 시 본인 이메일 등록 권장.
	# email admin@example.com

	# 운영 로그를 stdout으로 (docker logs caddy로 확인)
	log {
		output stdout
		format console
	}
}

# === 도메인 모드 ===
# {$DOMAIN}이 빈 문자열이면 매칭 안 되어 무시되고, 값이 있으면 이 블록 활성화
{$DOMAIN} {
	encode gzip zstd
	reverse_proxy api:4000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# === IP 직접 접근 / 도메인 미설정 폴백 ===
# 80번으로 들어오는 모든 요청 (DOMAIN과 매칭되지 않은 것 포함)을 api에 프록시
:80 {
	encode gzip
	reverse_proxy api:4000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
